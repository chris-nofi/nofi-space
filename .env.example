# Copy to .env and fill in. NEVER commit .env.

# --- NASA Earthdata (free: https://urs.earthdata.nasa.gov/users/new) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Oracle ---
ORACLE_PORT=8787
ORACLE_PRIVATE_KEY=            # test key only, signs EIP-712 attestations
ORACLE_CACHE_DIR=oracle/data/cache

# --- NØCHAIN testnet ---
NOCHAIN_RPC_URL=
NOCHAIN_CHAIN_ID=
NOCHAIN_EXPLORER=https://explorer-testnet.nofichain.com
# Legacy v1 (contracts/, not deployed in v2)
PLOT_REGISTRY_ADDRESS=
WATER_ESCROW_ADDRESS=
USDC_ADDRESS=

# --- Fuji fallback ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113

# --- Deployer (test key only) ---
DEPLOYER_PRIVATE_KEY=

# (Legacy v1 x402 gate vars removed: the v2 x402 server + facilitator are configured in avalanche/x402/.env)

# --- CERES: Claude API (server-side only) ---
# --- Plan v2: NØFI L1 + x402 (testnet only) ---
NOFI_CHAIN_ID=880024
NOFI_RPC_URL=https://rpc-testnet.nofichain.com/avalanche-l1/evm/880024
X402_EXPLORER_URL=https://nofiscan.io
WATER_PROOF_REGISTRY=
# Node x402 oracle (avalanche/x402) public HTTPS URL; when set, CERES pays it per answer
X402_EARTH_URL=
X402_NETWORK=eip155:880024
X402_ASSET=
X402_ASSET_NAME=Ceres x402 Test USDC
X402_ASSET_VERSION=1
X402_MAX_AMOUNT=100000
# Fresh testnet-only CERES agent wallet with a tiny tUSDCx balance. Never a real key.
CERES_AGENT_PRIVATE_KEY=
# Protects GET /v1/records/{farm}/{period}/package (what x402 sells)
ORACLE_ADMIN_TOKEN=
# Optional fixed month for CERES (YYYYMM); default = last closed month
CERES_DEFAULT_PERIOD=

ANTHROPIC_API_KEY=
CERES_TEXT_MODEL=claude-sonnet-5-5     # text chat
CERES_VOICE_MODEL=claude-haiku-5-5     # voice calls, lowest latency

# --- CERES: Retell voice (server-side only) ---
RETELL_API_KEY=
RETELL_VOICE_ID=                       # a Spanish (Latin America) voice from the Retell dashboard
RETELL_LANGUAGE=es-419
PUBLIC_WSS_URL=                        # e.g. wss://oracle.yourdomain.com (Retell must reach it)

# --- Web ---
VITE_ORACLE_URL=               # e.g. http://localhost:8787 ; empty = example data
VITE_EXPLORER_URL=https://explorer-testnet.nofichain.com
VITE_RETELL_PUBLIC_KEY=                # Retell PUBLIC key (domain-restricted), never the API key
VITE_RETELL_AGENT_ID=                  # printed by oracle/scripts/retell_setup.py
