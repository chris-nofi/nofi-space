# Copy to .env and fill in. NEVER commit .env.

# --- NASA Earthdata (free: https://urs.earthdata.nasa.gov/users/new) ---
EARTHDATA_USERNAME=
EARTHDATA_PASSWORD=

# --- Oracle ---
ORACLE_PORT=8787
ORACLE_PRIVATE_KEY=            # test key only, signs EIP-712 attestations
ORACLE_CACHE_DIR=oracle/data/cache

# --- NØCHAIN testnet ---
NOCHAIN_RPC_URL=
NOCHAIN_CHAIN_ID=
NOCHAIN_EXPLORER=https://explorer-testnet.nofichain.com
PLOT_REGISTRY_ADDRESS=
WATER_ESCROW_ADDRESS=
USDC_ADDRESS=                  # MockUSDC on testnet, or ICTT-bridged USDC

# --- Fuji fallback ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_CHAIN_ID=43113

# --- Deployer (test key only) ---
DEPLOYER_PRIVATE_KEY=

# --- x402 ---
X402_MODE=demo                 # demo | facilitator
X402_PRICE_USDC=0.05
X402_PAY_TO=                   # address that receives evidence-pack payments
X402_NETWORK=                  # e.g. eip155:<NOCHAIN_CHAIN_ID> or eip155:43113
X402_FACILITATOR_URL=          # self-hosted x402-rs for NØCHAIN, or an Avalanche facilitator for Fuji

# --- CERES: Claude API (server-side only) ---
ANTHROPIC_API_KEY=
CERES_TEXT_MODEL=claude-sonnet-5-5     # text chat
CERES_VOICE_MODEL=claude-haiku-5-5     # voice calls, lowest latency

# --- CERES: Retell voice (server-side only) ---
RETELL_API_KEY=
RETELL_VOICE_ID=                       # a Spanish (Latin America) voice from the Retell dashboard
RETELL_LANGUAGE=es-419
PUBLIC_WSS_URL=                        # e.g. wss://oracle.yourdomain.com (Retell must reach it)

# --- Web ---
VITE_ORACLE_URL=               # e.g. http://localhost:8787 ; empty = example data
VITE_EXPLORER_URL=https://explorer-testnet.nofichain.com
VITE_RETELL_PUBLIC_KEY=                # Retell PUBLIC key (domain-restricted), never the API key
VITE_RETELL_AGENT_ID=                  # printed by oracle/scripts/retell_setup.py
