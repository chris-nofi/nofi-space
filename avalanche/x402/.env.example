# Ceres Earth oracle x402: copy to .env (git-ignored). Public addresses only in this file.
# Demo network: Avalanche Fuji C-Chain. All asset defaults below already match Circle Fuji USDC,
# so on Fuji you only need X402_PAY_TO (and WATERPROOF_REGISTRY once deployed).
X402_CHAIN_ID=43113
X402_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
X402_EXPLORER=https://testnet.snowtrace.io
X402_ASSET=0x5425890298aed601595a70AB815c96711a31Bc65   # Circle USDC on Fuji (EIP-3009)
X402_ASSET_NAME="USD Coin"                               # = name() on-chain (quoted: it has a space)
X402_ASSET_VERSION=2                                     # = version() on-chain
X402_PAY_TO=0x...                          # Ceres Ventures treasury (public address). NOT the demo payer.
X402_PRICE_SCORE=20000                     # 0.02 USDC  /v1/field/:id/score    (testnet demo price)
X402_PRICE_EVIDENCE=50000                  # 0.05 USDC  /v1/field/:id/evidence (testnet demo price)
WATERPROOF_REGISTRY=0x...                  # WaterProofRegistry on Fuji (after DeployNofi.s.sol)
# X402_FACILITATOR_URL=https://facilitator.example   # run facilitator-server.mjs separately, behind HTTPS
# ALLOWED_ORIGINS=https://your-site.netlify.app      # CORS allowlist for pagar.html (default *)
#
# Facilitator gas wallet: export FACILITATOR_PRIVATE_KEY in the shell at runtime ONLY. Use a fresh wallet that
# holds nothing but a little Fuji AVAX for gas. Never write it into this file, git, chat or the app.
#
# Later, on the NØFI L1 (same code):
# X402_CHAIN_ID=880024  X402_ASSET=<X402TestUSDC>  X402_ASSET_NAME="Ceres x402 Test USDC"  X402_ASSET_VERSION=1
